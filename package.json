{
    "name": "deepwhale",
    "version": "1.0.0",
    "main": "./server.js",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "dev:server": "nodemon ./server",
        "start:backend": "node ./server",
        "start:frontend": "npm start --prefix client",
        "start": "npm run dev",
        "dev": "concurrently --kill-others-on-fail \"npm run start:backend\" \"npm run start:frontend\"",
        "build": "npm run build --prefix client",
        "eject": "npm run eject --prefix client",
        "test": "npm test --prefix client"
    },
    "private": true,
    "dependencies": {
        "axios": "^1.8.4",
        "bcryptjs": "^2.4.3",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^16.4.7",
        "ethers": "^6.13.5",
        "express": "^4.21.2",
        "express-mongo-sanitize": "^2.2.0",
        "express-rate-limit": "^6.11.2",
        "express-validator": "^7.2.1",
        "hpp": "^0.2.3",
        "jsonwebtoken": "^9.0.2",
        "lodash": "^4.17.21",
        "mongoose": "^8.13.2",
        "pokersolver": "^2.1.4",
        "socket.io": "^2.3.0",
        "underscore": "^1.13.7",
        "xss-clean": "^0.1.1"
    },
    "devDependencies": {
        "concurrently": "^9.1.2",
        "core-js": "^3.41.0",
        "nodemon": "^3.1.9",
        "raf": "^3.4.1"
    }
}
